function getRandomAnalysis() {
    const score = Math.floor(Math.random() * 11);
    let status = "";
    let comments = [];

    if (score <= 3) {
        status = "🟢 Низкий уровень загрязнения";
        comments = [
            "Локация практически чистая, замечен лишь единичный мелкий мусор.",
            "Значительных загрязнений не обнаружено. Чистая зона!",
            "Местность в хорошем состоянии, требуется минимальная точечная уборка."
        ];
    } else if (score <= 6) {
        status = "🟡 Средний уровень загрязнения";
        comments = [
            "Обнаружены скопления пластиковых бутылок и сухой упаковки.",
            "Зафиксирован бытовой мусор. Рекомендуется провести субботник.",
            "Умеренная замусоренность территории, нужен вывоз ТБО."
        ];
    } else {
        status = "🔴 Высокий уровень загрязнения!";
        comments = [
            "Обнаружена несанкционированная свалка крупногабаритных отходов.",
            "Критическое засорение территории! Требуется срочная экологическая акция.",
            "Сильное загрязнение природной зоны пластиком и отходами."
        ];
    }

    const randomComment = comments[Math.floor(Math.random() * comments.length)];
    return `${status}\n📊 Оценка: *${score}/10*\n💬 *Детали:* ${randomComment}`;
}

// Экспортируем функцию, чтобы её видел index.js
module.exports = { getRandomAnalysis };
